{
  "globalHeaders": {
    "Content-Security-Policy": "script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'",
    "X-Frame-Options": "DENY",
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "camera=(self), microphone=(), geolocation=(), payment=()"
  },
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/*.{css,js,json,png,ico,webmanifest,svg}",
      "/i18n/*",
      "/icons/*"
    ]
  },
  "routes": [
    {
      "route": "/config.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/ngsw.json",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/ngsw-worker.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/safety-worker.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/gurubook-sw.js",
      "headers": {
        "cache-control": "no-cache"
      }
    },
    {
      "route": "/push-text.js",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ]
}
